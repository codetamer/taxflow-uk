{
  "name": "@taxflow/web",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "TaxFlow UK - Web Application for Micro-Entity Accounts and CT600 Filing",
  "scripts": {
    "dev": "next dev --port 3000",
    "prebuild": "node -e \"const fs=require('fs'); if(!fs.existsSync('node_modules/@swc/helpers') && fs.existsSync('../../node_modules/@swc/helpers')) { fs.mkdirSync('node_modules/@swc', {recursive:true}); fs.cpSync('../../node_modules/@swc/helpers', 'node_modules/@swc/helpers', {recursive:true}); }\"",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "test": "node --experimental-strip-types --test tests/api.test.ts"
  },
  "dependencies": {
    "@taxflow/ct-engine": "*",
    "@taxflow/shield": "*",
    "@taxflow/doc-engine": "*",
    "@taxflow/ingestion": "*",
    "@taxflow/companies-house": "*",
    "@taxflow/db": "*",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^1.16.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.2",
    "@swc/helpers": "^0.5.15"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "typescript": "^5.7.3",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.5.2",
    "autoprefixer": "^10.4.20"
  }
}
